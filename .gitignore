# ==============================================================================
# THERAYU
# ==============================================================================
# NOTE ON PATTERN SCOPE
# Python packaging patterns like `build/`, `lib/` and `dist/` are unanchored in
# the usual boilerplate, so they match a directory of that name at ANY depth.
# That silently excluded therayu_app/lib/ — the whole Flutter application — from
# every commit. Anything borrowed from a Python .gitignore template is anchored
# with a leading slash here so it can only ever match the repository root.
# ==============================================================================

# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging, ROOT ONLY (see note above)
/build/
/dist/
/develop-eggs/
/downloads/
/eggs/
/.eggs/
/sdist/
/var/
/wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# ---- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---- Secrets -----------------------------------------------------------------
.env
.env.*
.envrc
.pypirc

# ---- Test / type-checker caches ----------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.cache

# ---- Notebooks ---------------------------------------------------------------
.ipynb_checkpoints/

# ---- Editors / OS ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.spyderproject
.spyproject
tempCodeRunnerFile.py

# .vscode/ is deliberately NOT ignored. tasks.json, launch.json and settings.json
# are how this project is meant to be run, so they belong in the repository.

# ---- Training data -----------------------------------------------------------
# ~289 MB of images. Regenerate with prepare_dataset.py; far past what GitHub
# should be asked to carry.
upper_body_ai/dataset/

# ---- Large model binaries ----------------------------------------------------
*.pt
*.pth
*.onnx
*.h5
*.keras

# ---- Session output ----------------------------------------------------------
upper_body_ai/output/
output/
*.log

# ---- Media -------------------------------------------------------------------
# Screen recordings used while debugging; not source.
*.mp4
*.mov
